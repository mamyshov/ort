# База данных PostgreSQL. Для разработки: npm run db:start (выведет строку подключения)
DATABASE_URL=postgres://app@127.0.0.1:54329/ort_prep

# Адрес сайта (для ссылок в письмах)
SITE_URL=http://localhost:3000

# ИИ-разбор ошибок (ключ хранится только на сервере)
ANTHROPIC_API_KEY=
# Экономия ИИ: потолок запросов в сутки на весь сайт, на одного человека и модель (по умолчанию дешёвая)
AI_GLOBAL_DAILY_LIMIT=500
AI_USER_TOTAL_DAILY_LIMIT=60
AI_MODEL=claude-haiku-5-5

# --- Платежи ---
# Тестовая оплата для разработки. В production игнорируется.
PAYMENTS_MOCK=
# Номера для переводов (показываются покупателю) и курс сома к доллару для автосверки сумм
ELSOM_PHONE=
KASPI_PHONE=
KGS_PER_USD=
# Секрет для уведомлений о переводах: POST /api/webhooks/transfer
TRANSFER_WEBHOOK_SECRET=
# Finik: заполнить после получения документации и ключей
FINIK_API_URL=
FINIK_API_KEY=
FINIK_WEBHOOK_SECRET=

# --- Почта (сброс пароля, письмо после оплаты) через Resend ---
RESEND_API_KEY=
MAIL_FROM=

# --- Вход через Google (необязательно) ---
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
