# База данных PostgreSQL. Для разработки: npm run db:start (выведет строку подключения)
DATABASE_URL=postgres://app@127.0.0.1:54329/course_platform

# Адрес сайта (для ссылок в письмах и сообщениях)
SITE_URL=http://localhost:3000

# Видео (Bunny Stream)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# ИИ (ключ хранится только на сервере)
ANTHROPIC_API_KEY=
# Экономия ИИ: потолок запросов в сутки на весь сайт, на одного человека и модель (по умолчанию дешёвая)
AI_GLOBAL_DAILY_LIMIT=500
AI_USER_TOTAL_DAILY_LIMIT=60
AI_MODEL=claude-haiku-5-5

# --- Воронка и платежи ---
# Окно скидки в часах от регистрации на вебинар
OFFER_HOURS=24
# Тестовая оплата для разработки. В production игнорируется.
PAYMENTS_MOCK=
# Номера для переводов (показываются покупателю) и курс сома к доллару для автосверки сумм
ELSOM_PHONE=
KASPI_PHONE=
KGS_PER_USD=
# Секрет для уведомлений о переводах: POST /api/webhooks/transfer
TRANSFER_WEBHOOK_SECRET=
# Finik: заполнить после получения документации и ключей
FINIK_API_URL=
FINIK_API_KEY=
FINIK_WEBHOOK_SECRET=

# --- Сообщения ---
# Секрет для планировщика: GET /api/cron/messages раз в минуту
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
RESEND_API_KEY=
MAIL_FROM=
# Пробная отправка без провайдеров (в разработке включена всегда)
MESSAGING_DRY_RUN=

# --- Пиксель Facebook (публичный идентификатор) ---
NEXT_PUBLIC_FB_PIXEL_ID=

# Видео на главной (необязательно): ссылка на встраивание YouTube/Vimeo/Bunny
HOME_VIDEO_URL=

# --- Вход через Google (необязательно) ---
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
