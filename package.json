{
  "name": "ort-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node db/tests/rls.test.mjs",
    "db:start": "db/dev-db.sh start",
    "db:stop": "db/dev-db.sh stop",
    "db:reset": "db/dev-db.sh reset",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-ort.mjs",
    "owner": "node --env-file=.env.local scripts/create-owner.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
